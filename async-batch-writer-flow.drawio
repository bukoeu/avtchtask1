                <mxCell id="insight" value="💡 Key Insight: Both threads enqueue independently and block.&#xa;The writer thread batches them into ONE transaction,&#xa;reducing lock overhead by ~50% (2 writes / 1 transaction)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=2;align=left;verticalAlign=top;" parent="1" vertex="1">
