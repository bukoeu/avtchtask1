<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" version="21.0.0">
  <diagram name="Async Command Execution Flow" id="async-cmd-flow">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="Async Command Execution Flow" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="280" y="20" width="700" height="50" as="geometry" />
        </mxCell>

        <!-- ===== MAIN THREAD SWIMLANE ===== -->
        <mxCell id="main_swim" value="Main Thread (stdin)" style="swimlane;startSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="30" y="90" width="200" height="620" as="geometry" />
        </mxCell>
        <mxCell id="rl1" value="readLine()" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="main_swim">
          <mxGeometry x="20" y="50" width="160" height="40" as="geometry" />
        </mxCell>
        <mxCell id="parse1" value="parser.parse(line)" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="main_swim">
          <mxGeometry x="20" y="110" width="160" height="40" as="geometry" />
        </mxCell>
        <mxCell id="submit1" value="processor.submit(cmd)" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="main_swim">
          <mxGeometry x="20" y="170" width="160" height="40" as="geometry" />
        </mxCell>
        <mxCell id="note_immediate" value="&#x21A9; returns immediately!" style="text;html=1;strokeColor=none;fillColor=#fff2cc;align=center;fontSize=10;fontStyle=2;" vertex="1" parent="main_swim">
          <mxGeometry x="10" y="215" width="180" height="25" as="geometry" />
        </mxCell>
        <mxCell id="rl2" value="readLine() (next cmd)" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="main_swim">
          <mxGeometry x="20" y="260" width="160" height="40" as="geometry" />
        </mxCell>
        <mxCell id="submit2" value="processor.submit(cmd)" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="main_swim">
          <mxGeometry x="20" y="320" width="160" height="40" as="geometry" />
        </mxCell>
        <mxCell id="dots" value="..." style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=20;" vertex="1" parent="main_swim">
          <mxGeometry x="70" y="370" width="60" height="30" as="geometry" />
        </mxCell>
        <mxCell id="exitwait" value="exitLatch.await()&#xa;(blocks until EXIT runs)" style="rounded=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="main_swim">
          <mxGeometry x="20" y="430" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="shutdown" value="executor.shutdown()&#xa;awaitTermination(10s)" style="rounded=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="main_swim">
          <mxGeometry x="20" y="500" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="done" value="System exits cleanly" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="main_swim">
          <mxGeometry x="20" y="570" width="160" height="30" as="geometry" />
        </mxCell>

        <!-- ===== COMMAND PROCESSOR SWIMLANE ===== -->
        <mxCell id="cp_swim" value="CommandProcessor" style="swimlane;startSize=30;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="300" y="90" width="210" height="420" as="geometry" />
        </mxCell>
        <mxCell id="exec_service" value="ExecutorService&#xa;newFixedThreadPool(4)" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="cp_swim">
          <mxGeometry x="25" y="50" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="queue" value="Internal Queue" style="shape=mxgraph.flowchart.queue;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="cp_swim">
          <mxGeometry x="35" y="130" width="140" height="70" as="geometry" />
        </mxCell>
        <mxCell id="shutdown_flag" value="AtomicBoolean&#xa;shutdownSignaled" style="rounded=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="cp_swim">
          <mxGeometry x="25" y="240" width="160" height="40" as="geometry" />
        </mxCell>
        <mxCell id="exit_latch" value="CountDownLatch&#xa;exitLatch (count=1)" style="rounded=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="cp_swim">
          <mxGeometry x="25" y="310" width="160" height="40" as="geometry" />
        </mxCell>

        <!-- ===== WORKER THREADS SWIMLANE ===== -->
        <mxCell id="worker_swim" value="Worker Threads (&times;4)" style="swimlane;startSize=30;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="580" y="90" width="220" height="480" as="geometry" />
        </mxCell>
        <mxCell id="cmd_exec" value="cmd.execute()" style="rounded=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="worker_swim">
          <mxGeometry x="20" y="50" width="180" height="40" as="geometry" />
        </mxCell>
        <mxCell id="service_call" value="service.login() /&#xa;service.modify() /&#xa;statsService.report()" style="rounded=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="worker_swim">
          <mxGeometry x="20" y="110" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="enqueue" value="writer.enqueue(sql)" style="rounded=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="worker_swim">
          <mxGeometry x="20" y="200" width="180" height="40" as="geometry" />
        </mxCell>
        <mxCell id="future_get" value="future.get() &#x23F3;&#xa;blocks until committed" style="rounded=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="worker_swim">
          <mxGeometry x="20" y="260" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="exit_signal" value="ExitCommand:&#xa;processor.signalExit()&#xa;exitLatch.countDown()" style="rounded=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="worker_swim">
          <mxGeometry x="20" y="360" width="180" height="60" as="geometry" />
        </mxCell>

        <!-- ===== DB WRITER SWIMLANE ===== -->
        <mxCell id="db_swim" value="db-writer-0 (single thread)" style="swimlane;startSize=30;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="870" y="90" width="220" height="480" as="geometry" />
        </mxCell>
        <mxCell id="poll" value="poll(10 ms)" style="rounded=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="db_swim">
          <mxGeometry x="20" y="50" width="180" height="40" as="geometry" />
        </mxCell>
        <mxCell id="drain" value="drainTo(batch, batchSize)" style="rounded=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="db_swim">
          <mxGeometry x="20" y="110" width="180" height="40" as="geometry" />
        </mxCell>
        <mxCell id="lock" value="lock.lock()&#xa;ReentrantLock(fair=true)" style="rounded=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="db_swim">
          <mxGeometry x="20" y="170" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="txn" value="BEGIN TRANSACTION&#xa;&#x2192; execute each SQL&#xa;COMMIT" style="rounded=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="db_swim">
          <mxGeometry x="20" y="240" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="unlock" value="lock.unlock()" style="rounded=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="db_swim">
          <mxGeometry x="20" y="320" width="180" height="40" as="geometry" />
        </mxCell>
        <mxCell id="complete_futures" value="future.complete() &#x2713;&#xa;releases worker threads" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="db_swim">
          <mxGeometry x="20" y="380" width="180" height="50" as="geometry" />
        </mxCell>

        <!-- ===== ARROWS ===== -->

        <!-- rl1 → parse1 → submit1 (internal) handled by swimlane order -->
        <mxCell id="a1" value="" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="rl1" target="parse1" parent="main_swim">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="parse1" target="submit1" parent="main_swim">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="rl2" target="submit2" parent="main_swim">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a4" value="" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="exitwait" target="shutdown" parent="main_swim">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a5" value="" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="shutdown" target="done" parent="main_swim">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- submit1 → queue (cross-swimlane) -->
        <mxCell id="b1" value="submit()" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#82b366;fontColor=#82b366;fontStyle=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;" edge="1" source="submit1" target="queue" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- submit2 → queue (cross-swimlane) -->
        <mxCell id="b2" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#82b366;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" source="submit2" target="queue" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- queue → cmd_exec -->
        <mxCell id="b3" value="worker picks up" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#9673a6;fontColor=#9673a6;fontStyle=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="queue" target="cmd_exec" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- cmd_exec → service_call → enqueue → future_get (internal worker) -->
        <mxCell id="c1" value="" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="cmd_exec" target="service_call" parent="worker_swim">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="service_call" target="enqueue" parent="worker_swim">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="enqueue" target="future_get" parent="worker_swim">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- enqueue → poll (WriteTask to db-writer queue) -->
        <mxCell id="d1" value="WriteTask" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#d79b00;fontColor=#d79b00;fontStyle=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="enqueue" target="poll" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- db-writer internal flow -->
        <mxCell id="d2" value="" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="poll" target="drain" parent="db_swim">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d3" value="" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="drain" target="lock" parent="db_swim">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d4" value="" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="lock" target="txn" parent="db_swim">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d5" value="" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="txn" target="unlock" parent="db_swim">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d6" value="" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="unlock" target="complete_futures" parent="db_swim">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- complete_futures → future_get (feedback, dashed) -->
        <mxCell id="e1" value="future.complete()" style="edgeStyle=orthogonalEdgeStyle;dashed=1;strokeColor=#82b366;fontColor=#82b366;fontStyle=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="complete_futures" target="future_get" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- exit_signal → exit_latch (countDown) -->
        <mxCell id="e2" value="countDown()" style="edgeStyle=orthogonalEdgeStyle;dashed=1;strokeColor=#b85450;fontColor=#b85450;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="exit_signal" target="exit_latch" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- exit_latch → exitwait (releases await) -->
        <mxCell id="e3" value="releases await()" style="edgeStyle=orthogonalEdgeStyle;dashed=1;strokeColor=#b85450;fontColor=#b85450;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="exit_latch" target="exitwait" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== LEGEND ===== -->
        <mxCell id="leg_title" value="Legend" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="30" y="740" width="80" height="30" as="geometry" />
        </mxCell>
        <mxCell id="leg1" value="Main Thread" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="30" y="780" width="130" height="30" as="geometry" />
        </mxCell>
        <mxCell id="leg2" value="CommandProcessor" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="175" y="780" width="150" height="30" as="geometry" />
        </mxCell>
        <mxCell id="leg3" value="Worker Threads" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="340" y="780" width="140" height="30" as="geometry" />
        </mxCell>
        <mxCell id="leg4" value="db-writer-0 / Write" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="495" y="780" width="150" height="30" as="geometry" />
        </mxCell>
        <mxCell id="leg5" value="Lock / Sync / Exit" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="660" y="780" width="140" height="30" as="geometry" />
        </mxCell>
        <mxCell id="leg_dashed" value="--- Async signal / callback" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="815" y="780" width="230" height="30" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
